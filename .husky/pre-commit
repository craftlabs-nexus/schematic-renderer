#!/usr/bin/env sh
# Many GUI git clients (IDE integrations, GitHub Desktop, etc.) launch with a
# minimal PATH that doesn't include user-installed runtime dirs. Prepend the
# common ones so pnpm is findable regardless of how git is invoked.
export PATH="$HOME/.local/bin:$HOME/.local/share/pnpm:/opt/homebrew/bin:/usr/local/bin:$PATH"

if command -v pnpm >/dev/null 2>&1; then
	pnpm exec lint-staged
else
	npx --no-install lint-staged
fi
